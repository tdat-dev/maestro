{
  "manifest_version": 3,
  "name": "Maestro for Chrome",
  "version": "0.1.4",
  "description": "Lets your Maestro agents use this browser: open tabs, read pages, click and type, each agent in its own tab group.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Maestro for Chrome",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
